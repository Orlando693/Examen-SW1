package {{packageName}}.api;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.test.web.servlet.MockMvc;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

@SpringBootTest
@AutoConfigureMockMvc
class {{className}}ControllerTest {
    @Autowired private MockMvc mockMvc;
    @Test void listAcceptsBoundedAllowlistedControls() throws Exception { mockMvc.perform(get("/api/{{tableName}}").param("page", "0").param("size", "10").param("sort", "{{id.name}},asc")).andExpect(status().isOk()); }
    @Test void listRejectsUnknownSort() throws Exception { mockMvc.perform(get("/api/{{tableName}}").param("sort", "notAllowed,asc")).andExpect(status().isBadRequest()); }
}
