# Backend
BACKEND_PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
COLLABORATION_RECONNECT_TTL_MS=5000
JWT_SECRET=<set-a-long-random-secret-in-your-local-env-file>
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001/collaboration

# Database
# Development-only compose.yaml uses local trust authentication.
DATABASE_URL="postgresql://examen_sw1@localhost:5432/examen_sw1?schema=public"
# Required only by isolated realtime/PostgreSQL integration suites. It never falls back to DATABASE_URL.
TEST_DATABASE_URL="postgresql://examen_sw1@localhost:5432/examen_sw1_test?schema=public"
# External PostgreSQL: replace placeholders only in a local .env file, never here.
# DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?schema=public"
