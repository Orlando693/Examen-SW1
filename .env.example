# Backend
BACKEND_PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
COLLABORATION_RECONNECT_TTL_MS=5000
COLLABORATION_PAYLOAD_BYTES=1048576
COLLABORATION_COMMAND_RATE_PER_SECOND=10
COLLABORATION_COMMAND_BURST_CAPACITY=10
COLLABORATION_PRESENCE_RATE_PER_SECOND=30
COLLABORATION_PRESENCE_BURST_CAPACITY=5
COLLABORATION_COMMAND_STRING_LENGTH=256
COLLABORATION_PRESENCE_IDENTIFIER_LENGTH=64
COLLABORATION_PRESENCE_SELECTION_CAPACITY=50
COLLABORATION_LAYOUT_UPDATE_CAPACITY=1000
COLLABORATION_JOIN_BUFFER_CAPACITY=128
COLLABORATION_SESSION_CAPACITY=512
COLLABORATION_DEDUPE_CAPACITY=512
COLLABORATION_DEDUPE_TTL_MS=600000
COLLABORATION_RATE_BUCKET_CAPACITY=4096
JWT_SECRET=<set-a-long-random-secret-in-your-local-env-file>
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Socket.IO server base URL; the browser client selects the /collaboration namespace.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# Database
# Development-only compose.yaml uses local trust authentication.
DATABASE_URL="postgresql://examen_sw1@localhost:5432/examen_sw1?schema=public"
# Required only by isolated realtime/PostgreSQL integration suites. It never falls back to DATABASE_URL.
TEST_DATABASE_URL="postgresql://examen_sw1@localhost:5432/examen_sw1_test?schema=public"
# External PostgreSQL: replace placeholders only in a local .env file, never here.
# DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?schema=public"
