generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  description           String?
  ownerId               String?  @db.Uuid
  revision              Int
  storageVersion        Int      @default(0)
  documentSchemaVersion Int      @default(1)
  model                 Json     @db.JsonB
  layout                Json     @db.JsonB
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  owner       User?               @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships ProjectMembership[]

  @@index([ownerId])
  @@map("projects")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  ownedProjects Project[]           @relation("ProjectOwner")
  memberships   ProjectMembership[]

  @@map("users")
}

enum ProjectMembershipRole {
  EDITOR
}

model ProjectMembership {
  projectId String                @db.Uuid
  userId    String                @db.Uuid
  role      ProjectMembershipRole @default(EDITOR)
  createdAt DateTime              @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_memberships")
}
